# What tool/deploy-reports.mjs --caddy writes straight after the opening line of attack.fm's block (and only that):
# the one path the keyboard posts reports to, passed to the collector on this machine. No access log line is written
# for it (log_skip is skip_log before Caddy 2.8), so nothing of who asked is kept by the web server either.
	# ghostkbd-reports: begin (tool/deploy-reports.mjs writes these lines; server/reports/README.md)
	handle /devkeyboard/report {
		request_body {
			max_size 100KB
		}
		log_skip
		reverse_proxy 127.0.0.1:8377
	}
	# ghostkbd-reports: end
