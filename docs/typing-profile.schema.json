{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/InfamousVague/GhostKbd/main/docs/typing-profile.schema.json",
  "title": "Ghost typing profile",
  "description": "How one person types, for Ghost Keyboard to import and export (docs/typing-profile.md).",
  "type": "object",
  "required": ["format", "version"],
  "properties": {
    "format": { "const": "ghost-typing-profile" },
    "version": { "const": 1 },
    "created": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "properties": { "app": { "type": "string" }, "model": { "type": "string" } }
    },
    "report": { "type": "string", "maxLength": 4000 },
    "layout": {
      "description": "The layout the top-level keys and slips are for. Absent means qwerty. A keyboard that does not have the layout skips them.",
      "enum": ["qwerty", "qwertz", "azerty", "spanish", "catalan", "swedish", "danish", "norwegian", "turkish", "russian", "ukrainian", "bulgarian", "macedonian", "serbian", "greek", "hebrew", "arabic", "persian", "urdu", "korean"]
    },
    "keys": { "$ref": "#/$defs/keys" },
    "slips": { "$ref": "#/$defs/slips" },
    "layouts": {
      "description": "Keys and slips for further layouts, by layout id. Optional; keyboards that read only one layout ignore it.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "keys": { "$ref": "#/$defs/keys" }, "slips": { "$ref": "#/$defs/slips" } }
      }
    },
    "words": {
      "type": "object",
      "properties": {
        "learned": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "next": {
          "description": "Next-word prediction's counts: for a context (one word in lower case, two words with a space between, or ^ for a sentence's start), the words that followed it, as shown, and how often. Optional; keyboards without prediction ignore it.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "properties": {
        "profile": { "type": "string", "maxLength": 6000 },
        "profileVersion": { "type": "integer", "minimum": 1, "description": "Which of Ghost Keyboard's style rules trained the profile; read back only from Ghost Keyboard's own files." },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": { "text": { "type": "string" }, "typed": { "type": "string", "description": "The sample exactly as typed, where text has a slip repaired." }, "kind": { "enum": ["chat", "writing"] } }
          }
        }
      }
    }
  },
  "$defs": {
    "keys": {
      "description": "Per letter key of the layout (one lower-case letter of its script): where the person aims at it.",
      "type": "object",
      "propertyNames": { "pattern": "^\\p{L}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["dx", "dy"],
        "properties": {
          "dx": { "type": "number", "minimum": -1.5, "maximum": 1.5, "description": "Right of the key's middle, in key widths." },
          "dy": { "type": "number", "minimum": -1.5, "maximum": 1.5, "description": "Below the key's middle, in key heights." },
          "samples": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "slips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pressed", "meant"],
        "properties": {
          "pressed": { "type": "string", "pattern": "^\\p{L}$" },
          "meant": { "type": "string", "pattern": "^\\p{L}$" },
          "count": { "type": "integer", "minimum": 1 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
